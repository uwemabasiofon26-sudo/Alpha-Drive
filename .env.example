# Copy this file's variable names into Vercel → Project → Settings →
# Environment Variables. Never commit a real .env file with actual secrets
# to git — this .env.example is safe to commit because it has no real values.

# Stripe — Dashboard → Developers → API keys. Use the sk_test_... key while
# testing, switch to the sk_live_... key when ready to accept real payments.
STRIPE_SECRET_KEY=

# Stripe — Dashboard → Developers → Webhooks → Add endpoint
#   URL: https://<your-domain>/api/stripe-webhook
#   Event: checkout.session.completed
# Stripe shows you a signing secret (starts "whsec_") after creating it —
# paste that here.
STRIPE_WEBHOOK_SECRET=

# Resend — Dashboard → API Keys → Create API Key
RESEND_API_KEY=

# Resend — Dashboard → Audiences → Create Audience → copy its ID.
# This is where newsletter subscribers are stored.
RESEND_AUDIENCE_ID=
