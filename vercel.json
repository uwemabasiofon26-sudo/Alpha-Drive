{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/product/fuel",
      "destination": "/product/glycoload",
      "permanent": true
    },
    {
      "source": "/product/erectavo",
      "destination": "/product/nitroxar",
      "permanent": true
    },
    {
      "source": "/product/alpha-night-recovery",
      "destination": "/product/night-recovery",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
